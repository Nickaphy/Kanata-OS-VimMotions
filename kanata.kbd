;; Entry point.
;;
;; Holding Caps Lock activates `mark-mode` (a plain `layer-while-held`
;; layer). Releasing Caps reverts to `insert` automatically - no exit
;; keypress needed. Caps's native uppercase-toggle is fully suppressed;
;; kanata consumes the raw key.
;;
;; `esc` stays in defsrc but is otherwise untouched - it passes through
;; as a literal Escape in every layer.

(include vim/1-interface.kbd)
(include vim/4-normal-layer.kbd)

(defalias
  boot-to-insert (layer-switch insert)
)

(defcfg
  process-unmapped-keys yes
  alias-to-trigger-on-load boot-to-insert   ;; always start kanata in insert mode
)

(defsrc
  caps
  esc
)

(deflayermap (insert)
  caps  (layer-while-held mark-mode)   ;; hold Caps: mark mode. release: back here.
  ___   use-defsrc                     ;; esc and anything else unlisted: pass through untouched
)
